# Copy to .env (Windows: copy .env.example .env) and fill in your values.
# news_bot.py loads it automatically. Never commit .env — it's in .gitignore.

GEMINI_API_KEY=paste-your-key-here  # Google AI Studio key (aistudio.google.com/apikey). Optional: without it you get headlines only
YOUTUBE_API_KEY=                    # Optional: for YouTube trending (see README). Blank = the Gemini key is tried instead
# GITHUB_TOKEN=                     # Optional: a GitHub personal access token (no scopes) raises the repo-search limit when running locally
SMTP_USER=you@gmail.com             # Gmail address that sends the digest
SMTP_PASSWORD=abcd efgh ijkl mnop   # Gmail App Password (not your normal password)
EMAIL_TO=you@gmail.com              # where the digest goes (comma-separate for several)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
